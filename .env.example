# --- Database (Supabase / PostgreSQL) ---
# Runtime connection. MUST be the pooled connection string (pgbouncer, port 6543)
# — the direct host is not reachable from Vercel's serverless network.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Used only by the Prisma CLI:
# db push / migrate / seed. Never used at runtime.
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- NextAuth / Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_SECRET="same-value-as-AUTH_SECRET"
AUTH_TRUST_HOST=true
# Local dev only. Do NOT set this on Vercel — it breaks preview deployments.
NEXTAUTH_URL="http://localhost:3000"

# --- Instagram enrichment (RapidAPI) ---
# Powers /api/ai/enrich-creator. Subscribe at rapidapi.com → instagram120
RAPIDAPI_KEY=""
RAPIDAPI_INSTAGRAM_HOST="instagram120.p.rapidapi.com"

# --- OpenAI (optional) ---
# Fills only the fields Instagram does not expose: niche, language, gender,
# audience demographics. Never touches follower/like/engagement numbers.
# Omit it and enrichment still works — those fields just stay empty.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
