# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creator_score"

# NextAuth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Required when self-hosting outside Vercel (Vercel sets trust automatically)
AUTH_TRUST_HOST=true

# Google OAuth (Google Login) - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
